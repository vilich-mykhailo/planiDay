generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model OwnerAccount {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  studios Studio[]
}

model ClientAccount {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String

  // базові дані
  name  String?
  phone String?

  // profile (те, що у твоєму Profile.jsx)
  firstName String?
  lastName  String?
  birthDate DateTime?
  gender    String? // "male" | "female" | "other" | "unknown"
  photoUrl  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]
}

enum Weekday {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

model Studio {
  id        String  @id @default(cuid())
  email     String  @default("")
  published Boolean @default(false)
  premium   Boolean @default(false)
  name      String  @default("")

  category          String            @default("")
  phone             String            @default("")
  description       String            @default("")
  city              String            @default("")
  street            String            @default("")
  building          String            @default("")
  apartment         String            @default("")
  serviceCategories ServiceCategory[]
  services          Service[]
  masters           Master[]
  coverUrl          String            @default("")
  logoUrl           String            @default("")
  portfolioUrls     Json              @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]

  slotDuration       Int                       @default(15)
  scheduleExceptions StudioScheduleException[]
  scheduleDays       StudioScheduleDay[]
  ownerId            String                    @unique
  owner              OwnerAccount              @relation(fields: [ownerId], references: [id])
}

model StudioScheduleDay {
  id       String @id @default(uuid())
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  day     Weekday
  enabled Boolean @default(true)

  startMin Int @default(600) // 10:00
  endMin   Int @default(1080) // 18:00

  @@unique([studioId, day])
  @@index([studioId])
}

model StudioScheduleException {
  id        String   @id @default(cuid())
  studioId  String
  date      DateTime
  enabled   Boolean  @default(true)
  startMin  Int?
  endMin    Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@unique([studioId, date])
  @@index([studioId, date])
}

model Booking {
  id       String @id @default(cuid())
  studioId String
  clientId String

  serviceId String? // ✅ додати
  masterId  String? // ✅ додати (якщо треба)

  startAt DateTime
  endAt   DateTime

  status    BookingStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  studio Studio        @relation(fields: [studioId], references: [id], onDelete: Cascade)
  client ClientAccount @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([studioId, startAt])
  @@index([clientId, startAt])
  @@index([serviceId, startAt])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELED
}

model ServiceCategory {
  id       String @id @default(uuid())
  name     String
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  services Service[]

  sort      Int      @default(0)
  createdAt DateTime @default(now())
}

model Service {
  id         String  @id @default(uuid())
  name       String
  duration   Int
  price      Int
  allMasters Boolean @default(true)

  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  categoryId String?
  category   ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  masters ServiceMaster[]

  sort      Int      @default(0)
  createdAt DateTime @default(now())
}

model ServiceMaster {
  serviceId String
  masterId  String

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  master  Master  @relation(fields: [masterId], references: [id], onDelete: Cascade)

  @@id([serviceId, masterId])
}

model Master {
  id       String  @id @default(cuid())
  studioId String
  name     String
  role     String?
  bio      String?
  photoUrl String?
  photoKey String?

  createdAt DateTime @default(now())

  studio   Studio          @relation(fields: [studioId], references: [id], onDelete: Cascade)
  services ServiceMaster[]
}
