generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model OwnerAccount {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  studios Studio[]
}

model ClientAccount {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String

  // базові дані
  name          String?
  phone         String?
  notifications Notification[]
  // profile (те, що у твоєму Profile.jsx)
  firstName     String?
  lastName      String?
  birthDate     DateTime?
  gender        String? // "male" | "female" | "other" | "unknown"
  photoUrl      String?

  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  favouriteStudios FavouriteStudio[]
  bookings         Booking[]
  studioClients    StudioClient[]
  isVip            Boolean             @default(false)
  vipSince         DateTime?
  notes            ClientNote[]
  salonStatuses    ClientSalonStatus[]
}

model FavouriteStudio {
  id        String   @id @default(cuid())
  clientId  String
  studioId  String
  createdAt DateTime @default(now())

  client ClientAccount @relation(fields: [clientId], references: [id], onDelete: Cascade)
  studio Studio        @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@unique([clientId, studioId])
  @@index([clientId])
  @@index([studioId])
}

enum Weekday {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

model Studio {
  id                String            @id @default(cuid())
  email             String            @default("")
  published         Boolean           @default(false)
  premium           Boolean           @default(false)
  name              String            @default("")
  notifications     Notification[]
  category          String            @default("")
  phone             String            @default("")
  description       String            @default("")
  city              String            @default("")
  street            String            @default("")
  building          String            @default("")
  apartment         String            @default("")
  serviceCategories ServiceCategory[]
  services          Service[]
  masters           Master[]
  coverUrl          String            @default("")
  logoUrl           String            @default("")
  portfolioUrls     Json              @default("[]")

  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  favouritedBy        FavouriteStudio[]
  bookings            Booking[]
  studioClients       StudioClient[]
  clientNotes         ClientNote[]
  clientSalonStatuses ClientSalonStatus[]
  slotDuration        Int                       @default(15)
  scheduleExceptions  StudioScheduleException[]
  scheduleDays        StudioScheduleDay[]
  ownerId             String                    @unique
  owner               OwnerAccount              @relation(fields: [ownerId], references: [id])
}

model StudioScheduleDay {
  id       String @id @default(uuid())
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  day     Weekday
  enabled Boolean @default(true)

  startMin Int @default(480) // 10:00
  endMin   Int @default(1020) // 18:00

  @@unique([studioId, day])
  @@index([studioId])
}

model StudioScheduleException {
  id        String   @id @default(cuid())
  studioId  String
  date      DateTime
  enabled   Boolean  @default(true)
  startMin  Int?
  endMin    Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@unique([studioId, date])
  @@index([studioId, date])
}

model StudioClient {
  id String @id @default(cuid())

  studioId  String
  accountId String?

  firstName String
  lastName  String
  phone     String?
  email     String?

  birthDate DateTime?
  photoUrl  String?
  photoKey  String?

  source StudioClientSource @default(MANUAL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studio  Studio         @relation(fields: [studioId], references: [id], onDelete: Cascade)
  account ClientAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  bookings Booking[]

  @@index([studioId])
  @@index([accountId])
}

model Booking {
  id             String  @id @default(cuid())
  studioId       String
  clientId       String
  studioClientId String?

  canceledBy String?

  ownerHiddenAt DateTime?
  notifications Notification[]
  serviceId     String?
  masterId      String?

  startAt DateTime
  endAt   DateTime

  status    BookingStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  studio       Studio        @relation(fields: [studioId], references: [id], onDelete: Cascade)
  client       ClientAccount @relation(fields: [clientId], references: [id], onDelete: Cascade)
  studioClient StudioClient? @relation(fields: [studioClientId], references: [id], onDelete: SetNull)

  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  master  Master?  @relation(fields: [masterId], references: [id], onDelete: SetNull)

  @@index([studioId, startAt])
  @@index([clientId, startAt])
  @@index([studioClientId, startAt])
  @@index([serviceId, startAt])
  @@index([masterId, startAt])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELED
}

enum StudioClientSource {
  BOOKING
  MANUAL
}

model Notification {
  id          String   @id @default(cuid())
  studioId    String
  clientId    String?
  bookingId   String?
  type        String
  title       String
  message     String
  clientName  String?
  serviceName String?
  oldDate     String?
  newDate     String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  studio  Studio         @relation(fields: [studioId], references: [id], onDelete: Cascade)
  client  ClientAccount? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  booking Booking?       @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([studioId, createdAt])
  @@index([clientId, createdAt])
  @@index([bookingId])
}

model ServiceCategory {
  id       String @id @default(uuid())
  name     String
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  services Service[]

  sort      Int      @default(0)
  createdAt DateTime @default(now())
}

model Service {
  id         String  @id @default(uuid())
  name       String
  duration   Int
  price      Int
  allMasters Boolean @default(true)

  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  categoryId String?
  category   ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  masters  ServiceMaster[]
  bookings Booking[]

  sort      Int      @default(0)
  createdAt DateTime @default(now())
}

model ServiceMaster {
  serviceId String
  masterId  String

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  master  Master  @relation(fields: [masterId], references: [id], onDelete: Cascade)

  @@id([serviceId, masterId])
}

model Master {
  id       String  @id @default(cuid())
  studioId String
  name     String
  role     String?
  bio      String?
  photoUrl String?
  photoKey String?

  createdAt DateTime @default(now())

  studio             Studio                    @relation(fields: [studioId], references: [id], onDelete: Cascade)
  services           ServiceMaster[]
  bookings           Booking[]
  scheduleDays       MasterScheduleDay[]
  scheduleExceptions MasterScheduleException[]

  @@index([studioId])
}

model MasterScheduleDay {
  id       String @id @default(uuid())
  masterId String
  master   Master @relation(fields: [masterId], references: [id], onDelete: Cascade)

  day     Weekday
  enabled Boolean @default(true)

  startMin Int @default(600)
  endMin   Int @default(1080)

  @@unique([masterId, day])
  @@index([masterId])
}

model MasterScheduleException {
  id        String   @id @default(cuid())
  masterId  String
  date      DateTime
  enabled   Boolean  @default(true)
  startMin  Int?
  endMin    Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  master Master @relation(fields: [masterId], references: [id], onDelete: Cascade)

  @@unique([masterId, date])
  @@index([masterId, date])
}

model ClientNote {
  id        String   @id @default(cuid())
  studioId  String
  clientId  String
  text      String
  createdAt DateTime @default(now())

  studio Studio        @relation(fields: [studioId], references: [id], onDelete: Cascade)
  client ClientAccount @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([studioId])
  @@index([clientId])
  @@index([studioId, clientId])
}

model ClientSalonStatus {
  id            String    @id @default(cuid())
  studioId      String
  clientId      String
  isFavorite    Boolean   @default(false)
  favoriteSince DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  studio Studio        @relation(fields: [studioId], references: [id], onDelete: Cascade)
  client ClientAccount @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([studioId, clientId])
  @@index([studioId])
  @@index([clientId])
}
